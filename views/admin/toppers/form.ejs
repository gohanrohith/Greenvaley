<%- include('../../partials/admin-nav') %>
<div class="page-header"><h2><%= item ? 'Edit Topper' : 'Add Topper' %></h2><a href="/admin/toppers" class="btn btn-outline">← Back</a></div>
<form method="POST" action="<%= item ? `/admin/toppers/${item.id}/edit` : '/admin/toppers/new' %>" enctype="multipart/form-data" class="admin-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="form-group"><label>Student Name *</label><input type="text" name="name" value="<%= item?.name || '' %>" required placeholder="e.g. Arjun Reddy"></div>

  <div class="form-row">
    <div class="form-group"><label>Exam *</label>
      <select name="exam" required>
        <option value="">— Select —</option>
        <% ['JEE Main','JEE Advanced','NEET','EAPCET','Board'].forEach(e => { %>
        <option value="<%= e %>" <%= item?.exam === e ? 'selected' : '' %>><%= e %></option>
        <% }); %>
      </select>
    </div>
    <div class="form-group"><label>Programme *</label>
      <select name="program" required>
        <option value="MPC" <%= item?.program === 'MPC' ? 'selected' : '' %>>MPC</option>
        <option value="BiPC" <%= item?.program === 'BiPC' ? 'selected' : '' %>>BiPC</option>
      </select>
    </div>
    <div class="form-group"><label>Batch Year *</label><input type="number" name="year" value="<%= item?.year || new Date().getFullYear() %>" min="2020" max="2035" required></div>
  </div>

  <div class="form-row">
    <div class="form-group"><label>Rank / Label * <small>(shown on card)</small></label><input type="text" name="rank_label" value="<%= item?.rank_label || '' %>" required placeholder="e.g. AIR 1543 or 99.8 Percentile"></div>
    <div class="form-group"><label>Score <small>(optional)</small></label><input type="text" name="score" value="<%= item?.score || '' %>" placeholder="e.g. 310/360 or 98.7%"></div>
  </div>

  <div class="form-group"><label>Highlight Badge <small>(optional — shown below name)</small></label><input type="text" name="highlight" value="<%= item?.highlight || '' %>" placeholder="e.g. Telangana State Rank 3"></div>

  <div class="form-row">
    <div class="form-group"><label>Sort Order</label><input type="number" name="sort_order" value="<%= item?.sort_order ?? 0 %>" min="0"></div>
    <div class="form-group"><label>Published</label>
      <select name="published">
        <option value="1" <%= !item || item.published ? 'selected' : '' %>>Yes</option>
        <option value="0" <%= item && !item.published ? 'selected' : '' %>>No (draft)</option>
      </select>
    </div>
  </div>

  <div class="form-group">
    <label>Photo <small>(optional — JPG/PNG, max 4 MB)</small></label>
    <% if (item?.photo) { %>
      <div style="margin-bottom:8px"><img src="<%= item.photo %>" style="width:80px;height:80px;object-fit:cover;border-radius:50%;border:2px solid var(--border)"></div>
      <label style="font-weight:400;font-size:.85rem"><input type="checkbox" name="remove_photo" value="1"> Remove current photo</label><br>
    <% } %>
    <input type="file" name="photo" accept="image/*" style="margin-top:6px">
  </div>

  <button type="submit" class="btn btn-primary">Save Topper</button>
</form>
<%- include('../../partials/admin-footer') %>
