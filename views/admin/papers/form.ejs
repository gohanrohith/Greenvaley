<%- include('../../partials/admin-nav') %>

<div class="page-header">
  <h2>Upload Question Paper</h2>
  <a href="/admin/question-papers" class="btn btn-outline">← Back</a>
</div>
<%- include('../../partials/flash') %>

<form method="POST" action="/admin/question-papers/new" enctype="multipart/form-data" class="admin-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="form-group">
    <label>Title *</label>
    <input type="text" name="title" required placeholder="e.g. Physics IPE March 2024">
  </div>
  <div class="form-row">
    <div class="form-group">
      <label>Subject *</label>
      <select name="subject" required>
        <option value="">— Select —</option>
        <% ['Physics','Chemistry','Maths','Biology','English','Telugu','Hindi','Sanskrit'].forEach(s => { %>
          <option value="<%= s %>"><%= s %></option>
        <% }); %>
      </select>
    </div>
    <div class="form-group">
      <label>Program *</label>
      <select name="program" required>
        <option value="Both">Both MPC & BiPC</option>
        <option value="MPC">MPC only</option>
        <option value="BiPC">BiPC only</option>
      </select>
    </div>
    <div class="form-group">
      <label>Year *</label>
      <input type="number" name="year" required min="2015" max="2035" value="<%= new Date().getFullYear() %>">
    </div>
    <div class="form-group">
      <label>Exam Type</label>
      <select name="exam_type">
        <option value="">— Optional —</option>
        <% ['IPE March','IPE May','Model','Quarterly','Half-Yearly'].forEach(t => { %>
          <option value="<%= t %>"><%= t %></option>
        <% }); %>
      </select>
    </div>
  </div>
  <div class="form-group">
    <label>PDF File *</label>
    <input type="file" name="file" accept=".pdf" required>
    <p class="text-muted">Max 20MB. PDF only.</p>
  </div>
  <button type="submit" class="btn btn-primary">Upload</button>
</form>

<%- include('../../partials/admin-footer') %>
