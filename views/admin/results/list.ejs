<%- include('../../partials/admin-nav') %>

<div class="page-header">
  <h2>Exam Results</h2>
  <a href="/admin/results/new" class="btn btn-primary">+ Add Result</a>
</div>
<%- include('../../partials/flash') %>

<table class="admin-table">
  <thead><tr><th>Roll No.</th><th>Name</th><th>Program</th><th>Exam</th><th>Year</th><th>Total</th><th>Grade</th><th>Pub</th><th>Actions</th></tr></thead>
  <tbody>
    <% if (results.length === 0) { %>
    <tr><td colspan="9" class="empty">No results yet.</td></tr>
    <% } %>
    <% results.forEach(r => { %>
    <tr>
      <td><%= r.roll_number %></td>
      <td><%= r.name %></td>
      <td><%= r.program %></td>
      <td><%= r.exam_type %></td>
      <td><%= r.year %></td>
      <td><%= r.total_marks || '—' %><%= r.max_marks ? `/${r.max_marks}` : '' %></td>
      <td><%= r.grade || '—' %></td>
      <td><span class="badge <%= r.published ? 'badge-success' : 'badge-muted' %>"><%= r.published ? 'Yes' : 'No' %></span></td>
      <td>
        <a href="/admin/results/<%= r.id %>/edit" class="btn btn-sm btn-outline">Edit</a>
        <form method="POST" action="/admin/results/<%= r.id %>/delete" style="display:inline" onsubmit="return confirm('Delete?')">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-sm btn-danger">Del</button>
        </form>
      </td>
    </tr>
    <% }); %>
  </tbody>
</table>

<%- include('../../partials/admin-footer') %>
