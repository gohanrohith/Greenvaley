<%- include('../../partials/admin-nav') %>
<div class="page-header"><h2>New Album</h2><a href="/admin/gallery" class="btn btn-outline">← Back</a></div>
<form method="POST" action="/admin/gallery/new" class="admin-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="form-group"><label>Album Title *</label><input type="text" name="title" required></div>
  <div class="form-group"><label>Description</label><textarea name="description" rows="3"></textarea></div>
  <button type="submit" class="btn btn-primary">Create Album</button>
</form>
<%- include('../../partials/admin-footer') %>
