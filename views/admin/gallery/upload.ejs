<%- include('../../partials/admin-nav') %>
<div class="page-header"><h2>Upload Photos — <%= album.title %></h2><a href="/admin/gallery" class="btn btn-outline">← Back</a></div>
<%- include('../../partials/flash') %>
<form method="POST" action="/admin/gallery/<%= album.id %>/upload" enctype="multipart/form-data" class="admin-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="form-group">
    <label>Select Photos (up to 30 at once)</label>
    <input type="file" name="photos" multiple accept="image/*" required>
  </div>
  <button type="submit" class="btn btn-primary">Upload</button>
</form>

<% if (photos.length) { %>
<h3 class="mt-3" style="font-size:.95rem;font-weight:700;margin-bottom:1rem">Photos in this album (<%= photos.length %>)</h3>
<div id="photoGrid" data-album="<%= album.id %>" data-csrf="<%= csrfToken %>"
  style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:1rem">
  <% photos.forEach(p => { %>
  <div data-photo-card data-photo-id="<%= p.id %>"
    style="border-radius:8px;overflow:hidden;background:#f5f5f5;border:1px solid #e0e0e0">
    <img src="/uploads/gallery/<%= p.filename %>" alt="<%= p.caption || '' %>"
      style="width:100%;height:110px;object-fit:cover;display:block">
    <div style="padding:.3rem .4rem .1rem;text-align:center;cursor:grab;color:#999;font-size:.7rem" title="Drag to reorder">
      ⠿ drag to reorder
    </div>
    <form method="POST" action="/admin/gallery/photo/<%= p.id %>/delete"
      onsubmit="return confirm('Delete photo?')" style="padding:.3rem .4rem .4rem">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-xs btn-danger" style="width:100%">✕ Remove</button>
    </form>
  </div>
  <% }); %>
</div>
<% } %>

<style>.sortable-ghost { opacity:.35; outline:2px dashed #6c63ff; }</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.6/Sortable.min.js"></script>
<script>
(function () {
  var grid = document.getElementById('photoGrid');
  if (!grid || typeof Sortable === 'undefined') return;
  Sortable.create(grid, {
    animation: 150,
    ghostClass: 'sortable-ghost',
    onEnd: function () {
      var ids = [].slice.call(grid.querySelectorAll('[data-photo-card]')).map(function (c) { return c.dataset.photoId; });
      var params = new URLSearchParams();
      params.append('_csrf', grid.dataset.csrf);
      ids.forEach(function (id) { params.append('ids[]', id); });
      fetch('/admin/gallery/' + grid.dataset.album + '/reorder', {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded' },
        body: params
      }).catch(function () {});
    }
  });
})();
</script>
<%- include('../../partials/admin-footer') %>
