<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
<aside class="sidebar">
  <div class="sidebar-brand"><%= college.shortName %> <span>Admin</span></div>
  <nav class="sidebar-nav">
    <a href="/admin">Dashboard</a>
    <div class="nav-section">Content</div>
    <a href="/admin/news">News</a>
    <a href="/admin/events">Events</a>
    <a href="/admin/gallery">Gallery</a>
    <div class="nav-section">Academic</div>
    <a href="/admin/question-papers">Question Papers</a>
    <a href="/admin/results">Exam Results</a>
    <div class="nav-section">Students</div>
    <a href="/admin/toppers">Achievements</a>
    <a href="/admin/scholarship">Scholarships</a>
    <a href="/admin/enquiries">Enquiries</a>
    <div class="nav-section">Scholarship Test</div>
    <a href="/admin/test">Test Dashboard</a>
    <a href="/admin/test/questions">Question Bank</a>
    <a href="/admin/test/sets">Test Sets</a>
    <a href="/admin/test/results">Results</a>
    <a href="/admin/test/live">Live Sessions</a>
    <div class="nav-section">Admin</div>
    <a href="/admin/disclosure">Mandatory Disclosure</a>
    <a href="/admin/settings">Settings</a>
    <% if (adminRole === 'super') { %>
    <a href="/admin/users">Users</a>
    <% } %>
    <a href="/admin/profile">My Profile</a>
    <a href="/admin/logout" class="logout-link">Logout</a>
  </nav>
</aside>
<div class="sidebar-overlay" id="sidebarOverlay"></div>
<main class="admin-main">
<header class="admin-header">
  <button class="hamburger" id="sidebarToggle" aria-label="Menu">
    <span></span><span></span><span></span>
  </button>
  <span class="admin-user">👤 <%= adminName %></span>
  <span id="adminSessionTimer" style="font-size:.72rem;color:#aaa;margin-left:.75rem"></span>
</header>
<div id="adminLogoutWarning" style="display:none;position:fixed;top:0;left:0;right:0;z-index:9999;background:#c0392b;color:#fff;text-align:center;padding:.75rem 1rem;font-size:.9rem;font-weight:600">
  Session expiring in <span id="adminCountdown">60</span>s — <a href="#" onclick="adminResetTimer();return false;" style="color:#fff;text-decoration:underline">Stay logged in</a> &nbsp;|&nbsp; <a href="/admin/logout" style="color:#fff;text-decoration:underline">Logout now</a>
</div>
<script>
(function(){
  var TIMEOUT=15*60*1000, WARN_BEFORE=60*1000;
  var timer, warnTimer, countdownInterval;
  var warningEl=document.getElementById('adminLogoutWarning');
  var countdownEl=document.getElementById('adminCountdown');
  var timerLabel=document.getElementById('adminSessionTimer');
  function fmt(ms){var m=Math.floor(ms/60000),s=Math.floor((ms%60000)/1000);return m+':'+(s<10?'0':'')+s;}
  function showWarning(){
    warningEl.style.display='block';
    var secs=Math.floor(WARN_BEFORE/1000);
    countdownEl.textContent=secs;
    countdownInterval=setInterval(function(){secs--;countdownEl.textContent=secs;if(secs<=0){clearInterval(countdownInterval);window.location.href='/admin/logout';}},1000);
  }
  function hideWarning(){warningEl.style.display='none';clearInterval(countdownInterval);}
  window.adminResetTimer=function(){
    clearTimeout(timer);clearTimeout(warnTimer);hideWarning();
    fetch('/admin/keepalive').catch(function(){});
    var remaining=TIMEOUT;
    timerLabel.textContent=fmt(remaining);
    var tick=setInterval(function(){remaining-=1000;if(remaining<=0){clearInterval(tick);}else{timerLabel.textContent=fmt(remaining);}},1000);
    warnTimer=setTimeout(showWarning,TIMEOUT-WARN_BEFORE);
    timer=setTimeout(function(){window.location.href='/admin/logout';},TIMEOUT);
  };
  ['mousemove','keydown','click','scroll','touchstart'].forEach(function(e){document.addEventListener(e,adminResetTimer,{passive:true});});
  adminResetTimer();
})();
</script>
<script>
  (function(){
    var btn = document.getElementById('sidebarToggle');
    var overlay = document.getElementById('sidebarOverlay');
    var sidebar = document.querySelector('.sidebar');
    function close(){ sidebar.classList.remove('open'); overlay.classList.remove('open'); }
    btn.addEventListener('click', function(){
      var open = sidebar.classList.toggle('open');
      overlay.classList.toggle('open', open);
    });
    overlay.addEventListener('click', close);
  })();
</script>
<div class="admin-content">
