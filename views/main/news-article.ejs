<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>

  <!-- Open Graph -->
  <meta property="og:type" content="article">
  <meta property="og:title" content="<%= article.title %>">
  <% if (article.excerpt) { %><meta property="og:description" content="<%= article.excerpt %>"><% } %>
  <meta property="og:image" content="<%= ogImage %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= article.title %>">
  <% if (article.excerpt) { %><meta name="twitter:description" content="<%= article.excerpt %>"><% } %>
  <meta name="twitter:image" content="<%= ogImage %>">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/images/logo.png">
  <style>
  .gt-article-gallery{margin:2rem 0;border:1px solid #e2e8f0;border-radius:8px;overflow:hidden}
  .gt-article-gallery-header{padding:.6rem 1rem;font-size:.84rem;font-weight:700;background:#f8fafc;border-bottom:1px solid #e2e8f0}
  .gt-bento-gallery{padding:6px}
  .gt-bento-grid{display:grid;gap:5px}
  .gt-bento-grid[data-sq="0"]{grid-template-columns:1fr;grid-template-rows:320px}
  .gt-bento-grid[data-sq="1"]{grid-template-columns:2fr 1fr;grid-template-rows:320px}
  .gt-bento-grid[data-sq="2"]{grid-template-columns:2fr 1fr;grid-template-rows:162px 162px}
  .gt-bento-grid[data-sq="3"],.gt-bento-grid[data-sq="4"]{grid-template-columns:2fr 1fr 1fr;grid-template-rows:162px 162px}
  .gt-bento-big{border-radius:5px;overflow:hidden;cursor:pointer;grid-column:1}
  .gt-bento-grid[data-sq="0"] .gt-bento-big,.gt-bento-grid[data-sq="1"] .gt-bento-big{grid-row:1}
  .gt-bento-grid[data-sq="2"] .gt-bento-big,.gt-bento-grid[data-sq="3"] .gt-bento-big,.gt-bento-grid[data-sq="4"] .gt-bento-big{grid-row:1/3}
  .gt-bento-sq{position:relative;border-radius:5px;overflow:hidden;cursor:pointer}
  .gt-bento-sq-1{grid-column:2;grid-row:1}.gt-bento-sq-2{grid-column:2;grid-row:2}
  .gt-bento-sq-3{grid-column:3;grid-row:1}.gt-bento-sq-4{grid-column:3;grid-row:2}
  .gt-bento-big img,.gt-bento-sq img{width:100%;height:100%;object-fit:cover;display:block}
  .gt-bento-more{position:absolute;inset:0;background:rgba(0,0,0,.56);display:flex;align-items:center;justify-content:center;color:#fff;font-size:1.4rem;font-weight:800;pointer-events:none}
  @media(max-width:560px){
    .gt-bento-grid[data-sq="1"],.gt-bento-grid[data-sq="2"],.gt-bento-grid[data-sq="3"],.gt-bento-grid[data-sq="4"]{grid-template-columns:1fr 1fr;grid-template-rows:150px 105px 105px}
    .gt-bento-big{grid-column:1/3;grid-row:1}
    .gt-bento-sq-1{grid-column:1;grid-row:2}.gt-bento-sq-2{grid-column:2;grid-row:2}
    .gt-bento-sq-3{grid-column:1;grid-row:3}.gt-bento-sq-4{grid-column:2;grid-row:3}
  }
  #gv-lightbox{display:none;position:fixed;inset:0;background:rgba(0,0,0,.92);z-index:9999;align-items:center;justify-content:center;flex-direction:column}
  #gv-lightbox.open{display:flex}
  #gv-lightbox img{max-width:90vw;max-height:82vh;object-fit:contain;border-radius:6px}
  #gv-lightbox .lb-cap{color:#ddd;font-size:.85rem;margin-top:.6rem;text-align:center}
  #gv-lightbox .lb-close{position:absolute;top:18px;right:22px;background:none;border:none;color:#fff;font-size:2rem;cursor:pointer;line-height:1}
  #gv-lightbox .lb-prev,#gv-lightbox .lb-next{position:absolute;top:50%;transform:translateY(-50%);background:rgba(255,255,255,.15);border:none;color:#fff;font-size:1.5rem;padding:.5rem .9rem;cursor:pointer;border-radius:4px}
  #gv-lightbox .lb-prev{left:12px}
  #gv-lightbox .lb-next{right:12px}
  </style>
</head>
<body>
<%- include('../partials/nav') %>

<div class="page-hero">
  <div class="container">
    <h1><%= article.title %></h1>
    <p><%= new Date(article.created_at).toLocaleDateString('en-IN', {day:'2-digit',month:'long',year:'numeric'}) %></p>
  </div>
</div>

<div class="container section">
  <div class="article-layout">
    <article class="article-body-card">
      <% if (article.image) { %>
        <img src="<%= article.image %>" alt="<%= article.title %>" class="article-hero-img" onerror="this.style.display='none'">
      <% } %>
      <% if (article.content_hi || article.content_te) { %>
      <div style="display:flex;gap:0;border-bottom:2px solid #e2e8f0;margin-bottom:1.25rem">
        <button type="button" class="lang-btn active" data-lang="en"
          style="padding:.45rem 1rem;font-size:.82rem;font-weight:600;border:none;background:none;cursor:pointer;color:#2d7a4f;border-bottom:2px solid #2d7a4f;margin-bottom:-2px">English</button>
        <% if (article.content_hi) { %>
        <button type="button" class="lang-btn" data-lang="hi"
          style="padding:.45rem 1rem;font-size:.82rem;font-weight:600;border:none;background:none;cursor:pointer;color:#888;border-bottom:2px solid transparent;margin-bottom:-2px">हिंदी</button>
        <% } %>
        <% if (article.content_te) { %>
        <button type="button" class="lang-btn" data-lang="te"
          style="padding:.45rem 1rem;font-size:.82rem;font-weight:600;border:none;background:none;cursor:pointer;color:#888;border-bottom:2px solid transparent;margin-bottom:-2px">తెలుగు</button>
        <% } %>
      </div>
      <% } %>
      <div class="article-content" id="content-en"><%- article.content %></div>
      <% if (article.content_hi) { %>
      <div class="article-content" id="content-hi" style="display:none"><%- article.content_hi %></div>
      <% } %>
      <% if (article.content_te) { %>
      <div class="article-content" id="content-te" style="display:none"><%- article.content_te %></div>
      <% } %>
    </article>
    <div class="mt-3">
      <a href="/news" class="btn btn-outline">← Back to News</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

<div id="gv-lightbox">
  <button class="lb-close" id="lbClose">&times;</button>
  <button class="lb-prev" id="lbPrev">&#8249;</button>
  <img id="lbImg" src="" alt="">
  <p class="lb-cap" id="lbCaption"></p>
  <button class="lb-next" id="lbNext">&#8250;</button>
</div>

<script>
// Lightbox
(function(){
  var lb=document.getElementById('gv-lightbox');
  var lbImg=document.getElementById('lbImg');
  var lbCap=document.getElementById('lbCaption');
  var lbData=[],cur=0;
  function showPhoto(){var p=lbData[cur];lbImg.src=p.src;lbCap.textContent=p.caption||'';}
  function open(data,idx){lbData=data;cur=((idx%data.length)+data.length)%data.length;showPhoto();lb.classList.add('open');document.body.style.overflow='hidden';}
  function close(){lb.classList.remove('open');document.body.style.overflow='';}
  document.getElementById('lbClose').onclick=close;
  document.getElementById('lbPrev').onclick=function(e){e.stopPropagation();cur=(cur-1+lbData.length)%lbData.length;showPhoto();};
  document.getElementById('lbNext').onclick=function(e){e.stopPropagation();cur=(cur+1)%lbData.length;showPhoto();};
  lb.onclick=function(e){if(e.target===lb)close();};
  document.addEventListener('keydown',function(e){if(!lb.classList.contains('open'))return;if(e.key==='Escape')close();if(e.key==='ArrowLeft')document.getElementById('lbPrev').click();if(e.key==='ArrowRight')document.getElementById('lbNext').click();});
  document.querySelectorAll('.gt-bento-gallery').forEach(function(gal){
    var data=[];try{data=JSON.parse(gal.dataset.photos.replace(/&quot;/g,'"'));}catch(e){}
    gal.querySelectorAll('[data-lb-index]').forEach(function(tile){
      tile.onclick=function(){open(data,parseInt(tile.dataset.lbIndex,10));};
    });
  });
})();

document.querySelectorAll('.lang-btn').forEach(function(btn){
  btn.addEventListener('click',function(){
    document.querySelectorAll('.lang-btn').forEach(function(b){
      b.style.color='#888';b.style.borderBottomColor='transparent';
    });
    btn.style.color='#2d7a4f';btn.style.borderBottomColor='#2d7a4f';
    ['en','hi','te'].forEach(function(l){
      var el=document.getElementById('content-'+l);
      if(el) el.style.display='none';
    });
    var target=document.getElementById('content-'+btn.dataset.lang);
    if(target) target.style.display='';
  });
});
</script>
</body>
</html>
