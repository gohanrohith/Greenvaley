<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>

  <!-- Open Graph -->
  <meta property="og:type" content="article">
  <meta property="og:title" content="<%= article.title %>">
  <% if (article.excerpt) { %><meta property="og:description" content="<%= article.excerpt %>"><% } %>
  <meta property="og:image" content="<%= ogImage %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= article.title %>">
  <% if (article.excerpt) { %><meta name="twitter:description" content="<%= article.excerpt %>"><% } %>
  <meta name="twitter:image" content="<%= ogImage %>">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/images/logo.png">
</head>
<body>
<%- include('../partials/nav') %>

<div class="page-hero">
  <div class="container">
    <h1><%= article.title %></h1>
    <p><%= new Date(article.created_at).toLocaleDateString('en-IN', {day:'2-digit',month:'long',year:'numeric'}) %></p>
  </div>
</div>

<div class="container section">
  <div class="article-layout">
    <article class="article-body-card">
      <% if (article.image) { %>
        <img src="<%= article.image %>" alt="<%= article.title %>" class="article-hero-img" onerror="this.style.display='none'">
      <% } %>
      <% if (article.content_hi || article.content_te) { %>
      <div style="display:flex;gap:0;border-bottom:2px solid #e2e8f0;margin-bottom:1.25rem">
        <button type="button" class="lang-btn active" data-lang="en"
          style="padding:.45rem 1rem;font-size:.82rem;font-weight:600;border:none;background:none;cursor:pointer;color:#2d7a4f;border-bottom:2px solid #2d7a4f;margin-bottom:-2px">English</button>
        <% if (article.content_hi) { %>
        <button type="button" class="lang-btn" data-lang="hi"
          style="padding:.45rem 1rem;font-size:.82rem;font-weight:600;border:none;background:none;cursor:pointer;color:#888;border-bottom:2px solid transparent;margin-bottom:-2px">हिंदी</button>
        <% } %>
        <% if (article.content_te) { %>
        <button type="button" class="lang-btn" data-lang="te"
          style="padding:.45rem 1rem;font-size:.82rem;font-weight:600;border:none;background:none;cursor:pointer;color:#888;border-bottom:2px solid transparent;margin-bottom:-2px">తెలుగు</button>
        <% } %>
      </div>
      <% } %>
      <div class="article-content" id="content-en"><%- article.content %></div>
      <% if (article.content_hi) { %>
      <div class="article-content" id="content-hi" style="display:none"><%- article.content_hi %></div>
      <% } %>
      <% if (article.content_te) { %>
      <div class="article-content" id="content-te" style="display:none"><%- article.content_te %></div>
      <% } %>
    </article>
    <div class="mt-3">
      <a href="/news" class="btn btn-outline">← Back to News</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
<script>
document.querySelectorAll('.lang-btn').forEach(function(btn){
  btn.addEventListener('click',function(){
    document.querySelectorAll('.lang-btn').forEach(function(b){
      b.style.color='#888';b.style.borderBottomColor='transparent';
    });
    btn.style.color='#2d7a4f';btn.style.borderBottomColor='#2d7a4f';
    ['en','hi','te'].forEach(function(l){
      var el=document.getElementById('content-'+l);
      if(el) el.style.display='none';
    });
    var target=document.getElementById('content-'+btn.dataset.lang);
    if(target) target.style.display='';
  });
});
</script>
</body>
</html>
