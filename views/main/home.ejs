<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<!-- Hero — full campus background -->
<section class="hero hero-fullbg">
  <div class="container">
    <div class="hero-left">
      <div class="hero-badge">TSBIE Affiliated &nbsp;·&nbsp; Yellapur, Hanamkonda</div>
      <h1>Two years that decide <span class="accent-light">the next twenty.</span></h1>
      <p class="hero-sub">Focused coaching for IIT-JEE and NEET, wrapped around a full intermediate curriculum — so the board exam and the entrance exam pull in the same direction.</p>
      <div class="hero-actions">
        <a href="/scholarship/apply" class="btn btn-gold btn-lg">Apply for up to 90% scholarship</a>
        <a href="tel:+91<%= college.phone %>" class="btn btn-ghost-white btn-lg">Call <%= college.phone %></a>
      </div>
      <div class="hero-prog-pills">
        <span class="hero-prog-pill">🎯 JEE Main &amp; Advanced</span>
        <span class="hero-prog-pill">🔬 NEET UG</span>
        <span class="hero-prog-pill">📐 JEE + EAPCET</span>
      </div>
    </div>
  </div>
  <!-- Stream cards — floated at bottom of hero -->
  <div class="hero-stream-bar">
    <div class="container">
      <div class="hero-stream-row">
        <div class="hero-sc">
          <div class="hero-sc-code">JEE</div>
          <div class="hero-sc-full">IIT-JEE Main &amp; Advanced</div>
          <div class="hero-sc-pills"><span>IITs</span><span>NITs</span><span class="gold">Class 11 &amp; 12</span></div>
        </div>
        <div class="hero-sc">
          <div class="hero-sc-code">NEET</div>
          <div class="hero-sc-full">NEET UG — Medical Entrance</div>
          <div class="hero-sc-pills"><span>MBBS</span><span>BDS</span><span class="gold">Girls only</span></div>
        </div>
        <div class="hero-sc">
          <div class="hero-sc-code">EAPCET</div>
          <div class="hero-sc-full">JEE Main &amp; EAPCET Combined</div>
          <div class="hero-sc-pills"><span>Engineering</span><span class="gold">Telangana</span></div>
        </div>
        <a href="/programs" class="hero-sc hero-sc-cta">
          <div class="hero-sc-cta-text">All Programmes →</div>
          <div class="hero-sc-cta-sub">View tracks &amp; details</div>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Scale Stats (item 2) -->
<div class="scale-strip">
  <div class="container">
    <div class="scale-grid">
      <div class="scale-card" data-reveal>
        <div class="scale-n green">6</div>
        <div class="scale-l">Programme Tracks</div>
        <div class="scale-sub">JEE · NEET · EAPCET</div>
      </div>
      <div class="scale-card" data-reveal>
        <div class="scale-n green">90%</div>
        <div class="scale-l">Max Merit Scholarship</div>
        <div class="scale-sub">Tuition fee waiver</div>
      </div>
      <div class="scale-card" data-reveal>
        <div class="scale-n green">TSBIE</div>
        <div class="scale-l">Affiliated &amp; Recognised</div>
        <div class="scale-sub">Telangana Board</div>
      </div>
      <div class="scale-card" data-reveal>
        <div class="scale-n green">2024</div>
        <div class="scale-l">Year Founded</div>
        <div class="scale-sub">Hanamkonda, Telangana</div>
      </div>
    </div>
  </div>
</div>

<!-- Our Journey Timeline (item 1) -->
<section class="timeline-section">
  <div class="container">
    <div class="section-head text-center-md" data-reveal>
      <div>
        <h2>Our Journey</h2>
        <p>22 years of building educational institutions across Telangana &amp; Andhra Pradesh</p>
      </div>
      <a href="/about" class="btn btn-outline btn-sm">About us →</a>
    </div>
    <div class="tl-outer" data-reveal>
      <div class="tl-line"></div>
      <div class="tl-track">

        <div class="tl-item">
          <div class="tl-year">2003</div>
          <div class="tl-dot"></div>
          <div class="tl-card">
            <div class="tl-inst">Greenwood High School</div>
            <div class="tl-loc">📍 Hanamkonda, Telangana</div>
            <div class="tl-type">CBSE School · Nursery – X</div>
          </div>
        </div>

        <div class="tl-item">
          <div class="tl-year">2010</div>
          <div class="tl-dot"></div>
          <div class="tl-card">
            <div class="tl-inst">Greenwood Warangal</div>
            <div class="tl-loc">📍 Warangal, Telangana</div>
            <div class="tl-type">High School · Extended Campus</div>
          </div>
        </div>

        <div class="tl-item">
          <div class="tl-year">2012</div>
          <div class="tl-dot"></div>
          <div class="tl-card">
            <div class="tl-inst">Abhyaas The Global School</div>
            <div class="tl-loc">📍 Bhimavaram, Andhra Pradesh</div>
            <div class="tl-type">CBSE School · Nursery – X</div>
          </div>
        </div>

        <div class="tl-item">
          <div class="tl-year">2017</div>
          <div class="tl-dot"></div>
          <div class="tl-card">
            <div class="tl-inst">Pinegrove Junior College</div>
            <div class="tl-loc">📍 Hyderabad, Telangana</div>
            <div class="tl-type">Intermediate College</div>
          </div>
        </div>

        <div class="tl-item">
          <div class="tl-year">2022</div>
          <div class="tl-dot"></div>
          <div class="tl-card">
            <div class="tl-inst">Greenwood Mancherial</div>
            <div class="tl-loc">📍 Mancherial, Telangana</div>
            <div class="tl-type">High School · Campus</div>
          </div>
        </div>

        <div class="tl-item tl-current">
          <div class="tl-year">2025</div>
          <div class="tl-dot"></div>
          <div class="tl-card">
            <div class="tl-badge-current">You are here</div>
            <div class="tl-inst">Greenvaley Junior College</div>
            <div class="tl-loc">📍 Hanamkonda, Telangana</div>
            <div class="tl-type">Intermediate · JEE · NEET · EAPCET</div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<!-- Why Greenvaley (item 3) -->
<section class="section why-section">
  <div class="container">
    <div class="section-head text-center-md">
      <h2>Why Greenvaley?</h2>
      <p>What makes us different from a regular junior college</p>
    </div>
    <div class="why-grid">
      <div class="why-card" data-reveal>
        <div class="why-icon why-icon-green">🎯</div>
        <h3>Board &amp; Entrance — aligned</h3>
        <p>Full TSBIE intermediate curriculum taught alongside IIT-JEE and NEET coaching. The board exam and the entrance exam pull in the same direction.</p>
      </div>
      <div class="why-card" data-reveal>
        <div class="why-icon why-icon-gold">🏅</div>
        <h3>Merit Scholarship</h3>
        <p>Up to 90% tuition fee waiver awarded purely on academic merit. Government schemes for SC / ST, BC, EBC and NTR Vidyonnathi also assisted.</p>
      </div>
      <div class="why-card" data-reveal>
        <div class="why-icon why-icon-blue">👨‍🏫</div>
        <h3>Expert Faculty</h3>
        <p>Teachers with deep subject expertise in Physics, Chemistry, Maths and Biology — selected for their results in competitive entrance coaching.</p>
      </div>
      <div class="why-card" data-reveal>
        <div class="why-icon why-icon-green">🤝</div>
        <h3>Personal Attention</h3>
        <p>Deliberately small batch sizes so every student gets individual academic tracking, doubt sessions, and mentored study plans.</p>
      </div>
    </div>
  </div>
</section>

<!-- Our Programs (item 6) -->
<section class="section bg-light programs-home-section">
  <div class="container">
    <div class="section-head">
      <div>
        <h2>Our Programmes</h2>
        <p>Two streams, six tracks — pick your goal</p>
      </div>
      <a href="/programs" class="btn btn-outline btn-sm">Full details →</a>
    </div>
    <div class="prog-home-grid">
      <div class="prog-home-card prog-home-mpc" data-reveal>
        <div class="prog-home-badge">MPC</div>
        <h3>Mathematics, Physics &amp; Chemistry</h3>
        <p class="prog-home-sub">Co-educational &nbsp;·&nbsp; Class 11 &amp; 12</p>
        <ul class="prog-home-tracks">
          <li><span class="pht-dot pht-green"></span><strong>JEE Main &amp; Advanced</strong> — IITs, NITs, BITS</li>
          <li><span class="pht-dot pht-green"></span><strong>JEE Main &amp; EAPCET</strong> — Engineering in Telangana</li>
          <li><span class="pht-dot pht-green"></span><strong>Intermediate &amp; EAPCET</strong> — Board-focused with state entrance</li>
        </ul>
        <a href="/programs" class="btn btn-primary btn-sm mt-2">Explore MPC →</a>
      </div>
      <div class="prog-home-card prog-home-bipc" data-reveal>
        <div class="prog-home-badge prog-home-badge-gold">BiPC</div>
        <h3>Biology, Physics &amp; Chemistry</h3>
        <p class="prog-home-sub">Girls only &nbsp;·&nbsp; Class 11 &amp; 12</p>
        <ul class="prog-home-tracks">
          <li><span class="pht-dot pht-gold"></span><strong>NEET UG</strong> — MBBS, BDS, Veterinary</li>
          <li><span class="pht-dot pht-gold"></span><strong>NEET + Board</strong> — Strong foundation with board excellence</li>
          <li><span class="pht-dot pht-gold"></span><strong>Board &amp; EAPCET</strong> — BiPC EAPCET (Agriculture, Pharmacy)</li>
        </ul>
        <a href="/programs" class="btn btn-gold btn-sm mt-2">Explore BiPC →</a>
      </div>
    </div>
  </div>
</section>

<!-- Scholarship strip -->
<section class="section-sm">
  <div class="container">
    <div class="schol-strip">
      <div>
        <h2>Up to 90% tuition scholarship — merit based</h2>
        <p>Awarded on performance in our scholarship test. SC / ST · BC · EBC · NTR Vidyonnathi government scholarships are also available. Send your details and we'll tell you which slab you qualify for. <a href="/scholarship/terms" style="color:rgba(255,255,255,.55);font-size:.8rem">Terms &amp; Conditions <span class="req">*</span></a></p>
      </div>
      <div class="schol-actions">
        <a href="/scholarship/apply" class="btn btn-gold">Apply Now <span class="req">*</span></a>
        <a href="/scholarship/status" class="btn btn-ghost-white">Track Status</a>
      </div>
    </div>
  </div>
</section>

<!-- Student Achievements — Linear Carousel -->
<section class="lc-section">
  <div class="container">
    <div class="lc-head" data-reveal>
      <div>
        <div class="lc-label">Student Achievements</div>
        <h2 class="lc-title">Our students in JEE, NEET &amp; EAPCET</h2>
      </div>
      <a href="/achievements" class="btn btn-ghost-white btn-sm">View All →</a>
    </div>
  </div>
  <div class="lc-track-wrap">
    <div class="lc-track" id="lcTrack">

      <% if (toppers && toppers.length) { %>
        <% toppers.forEach(t => { %>
        <div class="lc-card lc-card-<%= t.exam.toLowerCase().replace(/\s+/g,'-').replace(/[^a-z-]/g,'') %>">
          <% if (t.photo) { %>
            <img src="<%= t.photo %>" alt="<%= t.name %>" class="lc-card-bg-img">
          <% } %>
          <div class="lc-card-overlay"></div>
          <div class="lc-card-body">
            <div class="lc-card-cat"><%= t.exam %></div>
            <div class="lc-card-rank"><%= t.rank_label %></div>
            <div class="lc-card-name"><%= t.name %></div>
            <% if (t.highlight) { %><div class="lc-card-highlight"><%= t.highlight %></div><% } %>
          </div>
        </div>
        <% }); %>
      <% } else { %>
        <div class="lc-card lc-card-jee-main">
          <div class="lc-card-overlay"></div>
          <div class="lc-card-body">
            <div class="lc-card-cat">MPC · JEE</div>
            <div class="lc-card-rank">IIT-JEE Main &amp; Advanced</div>
            <div class="lc-card-name">IITs &nbsp;·&nbsp; NITs &nbsp;·&nbsp; BITS</div>
            <div class="lc-card-highlight">Admissions Open 2025–26</div>
          </div>
        </div>
        <div class="lc-card lc-card-neet">
          <div class="lc-card-overlay"></div>
          <div class="lc-card-body">
            <div class="lc-card-cat">BiPC · NEET</div>
            <div class="lc-card-rank">NEET UG</div>
            <div class="lc-card-name">MBBS &nbsp;·&nbsp; BDS &nbsp;·&nbsp; Veterinary</div>
            <div class="lc-card-highlight">Girls only</div>
          </div>
        </div>
        <div class="lc-card lc-card-eapcet">
          <div class="lc-card-overlay"></div>
          <div class="lc-card-body">
            <div class="lc-card-cat">MPC · EAPCET</div>
            <div class="lc-card-rank">JEE Main &amp; EAPCET</div>
            <div class="lc-card-name">Engineering in Telangana</div>
            <div class="lc-card-highlight">State quota advantage</div>
          </div>
        </div>
        <div class="lc-card lc-card-board">
          <div class="lc-card-overlay"></div>
          <div class="lc-card-body">
            <div class="lc-card-cat">Scholarship</div>
            <div class="lc-card-rank">Up to 90%</div>
            <div class="lc-card-name">Tuition fee waiver</div>
            <div class="lc-card-highlight">Merit based · Apply now</div>
          </div>
        </div>
        <div class="lc-card lc-card-coming">
          <div class="lc-card-overlay"></div>
          <div class="lc-card-body">
            <div class="lc-card-cat">First Batch</div>
            <div class="lc-card-rank">2026</div>
            <div class="lc-card-name">Results coming soon</div>
            <div class="lc-card-highlight">JEE · NEET · EAPCET · Board</div>
          </div>
        </div>
      <% } %>

    </div>
  </div>
  <div class="lc-drag-hint">← drag to explore →</div>
</section>

<!-- Leadership (item 5) -->
<section class="section leadership-home-section">
  <div class="container">
    <div class="section-head">
      <div>
        <h2>Our Leadership</h2>
        <p>The people behind Greenvaley</p>
      </div>
      <a href="/about#leadership" class="btn btn-outline btn-sm">Full team →</a>
    </div>
    <div class="lh-grid">
      <% college.directors.forEach(d => { %>
      <a href="/about#leadership" class="lh-card" data-reveal>
        <% if (d.photo) { %>
          <img src="<%= d.photo %>" alt="<%= d.name %>" class="lh-photo"
               onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
          <div class="lh-photo-placeholder" style="display:none"><%= d.name.charAt(0) %></div>
        <% } else { %>
          <div class="lh-photo-placeholder"><%= d.name.charAt(0) %></div>
        <% } %>
        <div class="lh-info">
          <div class="lh-role"><%= d.role %></div>
          <div class="lh-name"><%= d.name %></div>
          <div class="lh-designation"><%= d.designation %></div>
          <p class="lh-bio"><%= d.bio.length > 100 ? d.bio.substring(0, 100) + '…' : d.bio %></p>
        </div>
      </a>
      <% }); %>
    </div>
  </div>
</section>

<!-- News -->
<% if (news && news.length) { %>
<section class="section bg-light">
  <div class="container">
    <div class="section-head">
      <h2>Latest News</h2>
      <p>Updates from the college</p>
    </div>
    <div class="news-grid">
      <% news.forEach(n => { %>
      <article class="news-card">
        <% if (n.image) { %>
          <img src="<%= n.image %>" alt="<%= n.title %>" class="news-card-img">
        <% } else { %>
          <div class="news-card-img-placeholder">📰</div>
        <% } %>
        <div class="news-card-body">
          <h4><a href="/news/<%= n.slug %>"><%= n.title %></a></h4>
          <time><%= new Date(n.created_at).toLocaleDateString('en-IN', {day:'2-digit',month:'short',year:'numeric'}) %></time>
        </div>
      </article>
      <% }); %>
    </div>
    <div class="text-center mt-2">
      <a href="/news" class="btn btn-outline">All News</a>
    </div>
  </div>
</section>
<% } %>

<!-- Events -->
<% if (events && events.length) { %>
<section class="section">
  <div class="container">
    <div class="section-head">
      <h2>Upcoming Events</h2>
    </div>
    <div class="event-list">
      <% events.forEach(e => { %>
      <%
        const d = new Date(e.event_date);
        const day = d.toLocaleDateString('en-IN', {day:'2-digit'});
        const mon = d.toLocaleDateString('en-IN', {month:'short'});
      %>
      <div class="event-item">
        <div class="event-date-box">
          <div class="event-date-day"><%= day %></div>
          <div class="event-date-mon"><%= mon %></div>
        </div>
        <div class="event-info">
          <h4><%= e.title %></h4>
          <% if (e.venue) { %><p><%= e.venue %></p><% } %>
          <% if (e.description) { %><p class="text-muted"><%= e.description %></p><% } %>
        </div>
      </div>
      <% }); %>
    </div>
    <div class="text-center mt-2">
      <a href="/events" class="btn btn-outline">All Events</a>
    </div>
  </div>
</section>
<% } %>

<%- include('../partials/footer') %>
