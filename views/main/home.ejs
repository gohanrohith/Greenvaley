      <div>
        <div class="tl2-sup">Est. 2003 &nbsp;·&nbsp; 5 Institutions</div>
        <h2>Our Journey</h2>
      </div>
      <a href="/about" class="btn btn-outline btn-sm">About us →</a>
    </div>
    <div class="tl2-scroll" data-reveal>
      <div class="tl2-track">

        <div class="tl2-item">
          <div class="tl2-node">
            <span class="tl2-yr">2003</span>
          </div>
          <div class="tl2-card">
            <div class="tl2-num">01</div>
            <div class="tl2-name">Greenwood High School</div>
            <div class="tl2-loc">Hanamkonda, Telangana</div>
            <div class="tl2-type">CBSE · Nursery – Class X</div>
          </div>
        </div>

        <div class="tl2-connector"></div>

        <div class="tl2-item">
          <div class="tl2-node">
            <span class="tl2-yr">2012</span>
          </div>
          <div class="tl2-card">
            <div class="tl2-num">02</div>
            <div class="tl2-name">Abhyaas The Global School</div>
            <div class="tl2-loc">Bhimavaram, Andhra Pradesh</div>
            <div class="tl2-type">CBSE · Nursery – Class X</div>
          </div>
        </div>

        <div class="tl2-connector"></div>

        <div class="tl2-item">
          <div class="tl2-node">
            <span class="tl2-yr">2017</span>
          </div>
          <div class="tl2-card">
            <div class="tl2-num">03</div>
            <div class="tl2-name">Pinegrove Junior College</div>
            <div class="tl2-loc">Hyderabad, Telangana</div>
