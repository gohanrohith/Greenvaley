<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<div class="page-hero">
  <div class="container">
    <h1>Admissions <%= new Date().getFullYear() %>–<%= new Date().getFullYear() + 1 %></h1>
    <p>MPC and BiPC programmes — IIT-JEE, NEET, and EAPCET preparation</p>
  </div>
</div>

<div class="container section">
  <div class="admission-layout">

    <div class="admission-main">

      <h2 class="section-label">Eligibility</h2>
      <div class="elig-grid">
        <div class="elig-card">
          <div class="elig-icon">🎓</div>
          <div>
            <h4>SSC / 10th Passed</h4>
            <p>From any TSBIE-recognised or equivalent board</p>
          </div>
        </div>
        <div class="elig-card">
          <div class="elig-icon">📊</div>
          <div>
            <h4>Minimum 60% Aggregate</h4>
            <p>Relaxation for SC / ST / BC candidates as per TSBIE norms</p>
          </div>
        </div>
      </div>

      <h2 class="section-label mt-3">How to Apply</h2>
      <div class="steps">
        <div class="step">
          <div class="step-num">1</div>
          <div class="step-body">
            <h4>Visit the College Office</h4>
            <p>Come to our campus in Yellapur, Hanamkonda with your original documents and passport photographs.</p>
          </div>
        </div>
        <div class="step">
          <div class="step-num">2</div>
          <div class="step-body">
            <h4>Fill the Admission Form</h4>
            <p>Complete the admission form at the office and pay the registration fee.</p>
          </div>
        </div>
        <div class="step">
          <div class="step-num">3</div>
          <div class="step-body">
            <h4>Counselling / Interview</h4>
            <p>Attend the brief counselling session if called. This helps us place you in the right stream.</p>
          </div>
        </div>
        <div class="step">
          <div class="step-num">4</div>
          <div class="step-body">
            <h4>Pay &amp; Enroll</h4>
            <p>Complete the tuition fee payment and finalise your enrollment. Apply for scholarship<span class="req">*</span> if eligible.</p>
          </div>
        </div>
      </div>

    </div>

    <div class="admission-side">

      <div class="side-card">
        <h4>Documents Required</h4>
        <ul class="doc-list">
          <li>SSC Marks Memo (original + copy)</li>
          <li>Transfer Certificate from previous school</li>
          <li>Caste Certificate (if applicable)</li>
          <li>Income Certificate (for scholarship<span class="req">*</span>)</li>
          <li>Aadhaar Card</li>
          <li>4 Passport-size Photographs</li>
        </ul>
      </div>

      <div class="side-card side-card-dark">
        <h4>Up to 90% Scholarship <span class="req">*</span></h4>
        <p>Merit-based tuition fee waiver awarded on our scholarship test <span class="req">*</span>. Government schemes (SC/ST, BC, EBC, NTR Vidyonnathi) also available.</p>
        <a href="/scholarship/apply" class="btn btn-gold btn-sm mt-1">Apply for Scholarship <span class="req">*</span></a>
        <a href="/scholarship/terms" style="display:block;margin-top:10px;font-size:.78rem;color:rgba(255,255,255,.45)">Terms &amp; Conditions →</a>
      </div>

      <div class="side-card">
        <h4>Contact Admissions</h4>
        <p class="text-muted" style="margin-bottom:10px">Mon – Sat &nbsp;·&nbsp; 9 AM – 5 PM</p>
        <a href="tel:+91<%= college.phone %>" class="btn btn-outline btn-sm" style="width:100%;justify-content:center;margin-bottom:8px"><%= college.phone %></a>
        <% if (college.phone2) { %>
        <a href="tel:+91<%= college.phone2 %>" class="btn btn-ghost btn-sm" style="width:100%;justify-content:center"><%= college.phone2 %></a>
        <% } %>
      </div>

    </div>
  </div>
</div>

<%- include('../partials/footer') %>
