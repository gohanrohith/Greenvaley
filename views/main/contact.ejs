<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<div class="page-hero">
  <div class="container">
    <h1>Contact Us</h1>
    <p>We're here to help — reach us by phone, email, or the form below</p>
  </div>
</div>

<div class="container section">

  <%- include('../partials/flash') %>

  <div class="contact-layout">

    <div class="contact-info-col">
      <h2 style="font-size:1.5rem;margin-bottom:8px">Get in Touch</h2>
      <p class="text-muted" style="margin-bottom:32px">For admissions, scholarships, or general enquiries — our staff are available Monday to Saturday.</p>

      <div class="cinfo-list">
        <div class="cinfo-item">
          <div class="cinfo-icon-box">📧</div>
          <div>
            <div class="cinfo-label">Email</div>
            <a href="mailto:<%= college.email %>" class="cinfo-value"><%= college.email %></a>
          </div>
        </div>
        <div class="cinfo-item">
          <div class="cinfo-icon-box">📞</div>
          <div>
            <div class="cinfo-label">Phone</div>
            <a href="tel:+91<%= college.phone %>" class="cinfo-value"><%= college.phone %></a>
            <% if (college.phone2) { %>
            <a href="tel:+91<%= college.phone2 %>" class="cinfo-value" style="display:block"><%= college.phone2 %></a>
            <% } %>
          </div>
        </div>
        <% if (college.whatsapp) { %>
        <div class="cinfo-item">
          <div class="cinfo-icon-box" style="background:#dcfce7">
            <svg viewBox="0 0 24 24" style="width:20px;height:20px;fill:#16a34a" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </div>
          <div>
            <div class="cinfo-label">WhatsApp</div>
            <a href="https://wa.me/<%= college.whatsapp %>" target="_blank" rel="noopener" class="cinfo-value">+91 <%= college.whatsapp.replace('91','') %></a>
          </div>
        </div>
        <% } %>
        <div class="cinfo-item">
          <div class="cinfo-icon-box">📍</div>
          <div>
            <div class="cinfo-label">Address</div>
            <div class="cinfo-value"><%= college.address %>, Telangana</div>
          </div>
        </div>
        <div class="cinfo-item">
          <div class="cinfo-icon-box">🕐</div>
          <div>
            <div class="cinfo-label">Office Hours</div>
            <div class="cinfo-value">Mon – Sat &nbsp;·&nbsp; 9:00 AM – 5:00 PM</div>
          </div>
        </div>
      </div>
    </div>

    <form method="POST" action="/contact" class="contact-form-card">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <h3 style="margin-bottom:20px">Send a Message</h3>
      <div class="form-row">
        <div class="form-group">
          <label>Name *</label>
          <input type="text" name="name" required placeholder="Your full name">
        </div>
        <div class="form-group">
          <label>Phone</label>
          <input type="tel" name="phone" placeholder="10-digit mobile number">
        </div>
      </div>
      <div class="form-group">
        <label>Email *</label>
        <input type="email" name="email" required placeholder="you@example.com">
      </div>
      <div class="form-group">
        <label>Subject</label>
        <input type="text" name="subject" placeholder="Admissions, scholarship, etc.">
      </div>
      <div class="form-group">
        <label>Message *</label>
        <textarea name="message" rows="5" required placeholder="Write your message here…"></textarea>
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center">Send Message</button>
    </form>

  </div>
</div>

<%- include('../partials/footer') %>
