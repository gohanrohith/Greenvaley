# Copy this file to .env and fill in your values

# Server
PORT=8569
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=greenvaley_db
DB_USER=root
DB_PASS=

# Session
SESSION_SECRET=change-this-to-a-long-random-string

# Main domain
# Local dev: localhost  |  Production: greenvaley.ac.in
MAIN_DOMAIN=localhost

# Email (Hostinger SMTP)
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USER=office@greenvaley.ac.in
MAIL_PASS=
MAIL_FROM=Greenvaley Junior College <office@greenvaley.ac.in>

# Persistent uploads directory (set to absolute path OUTSIDE git repo on production)
# Example on Hostinger: UPLOADS_DIR=/home/u123456789/greenvaley-uploads
# Leave blank in dev (defaults to public/uploads inside the project)
UPLOADS_DIR=

# Telegram bot notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
